# local-search systemd unit (template — adjust paths and user).
#
# Ingestion normally runs separately (see docs/PRODUCTION.md), typically from a
# systemd timer or cron -- or let the service do it itself by setting
# LS_INGEST_INTERVAL (and optionally LS_INGEST_SYNC=true) in the EnvironmentFile:
# one background task, a catch-up run at startup, then every interval.

[Unit]
Description=local-search (text + image search service)
Documentation=file:/opt/local-search/docs/PRODUCTION.md
After=network.target

[Service]
Type=simple
User=locals
Group=locals
WorkingDirectory=/opt/local-search
EnvironmentFile=/opt/local-search/.env
ExecStart=/opt/local-search/local-search serve
Restart=on-failure
RestartSec=2

# All service state is the SQLite database (absolute path in LS_DB_PATH).
ReadWritePaths=/var/lib/local-search

# Hardening.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
