# container configuration
#
# Copy to a directory mounted at /config as `.env`:
#   cp .env.example /srv/local-search/config/.env
#   docker run -v /srv/local-search/config:/config ...
#
# Docker ENV variables take precedence over this file (the binary's dotenvy
# loader does not override the environment), so the container defaults below
# only need overriding when they differ.

# ---- storage & source (all on mounted volumes) -----------------------------
LS_DB_PATH=/data/local-search.db
LS_SOURCE_PATH=/documents

# ---- models ----------------------------------------------------------------
# Must be writable for the first-run download; mount a volume here.
LS_MODELS_DIR=/models
# Set to 1 to skip the automatic first-run download (pre-provisioned volume, or
# a remote-VLM / LS_EMBED_PROVIDER=llamacpp setup).
# LS_SKIP_MODEL_DOWNLOAD=0

# ---- extraction / embeddings -----------------------------------------------
# onnx = local docling ONNX pipeline (default); vlm = remote OpenAI-compatible
# VLM via llama.cpp (set the DOCLING_RS_VLM_* variables below).
LS_EXTRACT_PIPELINE=onnx
# CodeFormulaV2 code/formula enrichment (models fetched on first run).
LS_EXTRACT_CODE_FORMULA=true
LS_EMBED_PROVIDER=onnx
LS_EMBED_DIM=384
# SigLIP2 image+text space (models fetched on first run); set off to disable.
LS_IMAGE_EMBED_PROVIDER=siglip
LS_CHUNKER=hybrid

# ---- service ---------------------------------------------------------------
# Must bind all interfaces inside the container, or the published port cannot
# reach it. Publish with `-p 8080:8080`.
LS_ADDR=0.0.0.0:8080
# Comma-separated; empty disables authentication.
# LS_API_KEYS=change-me

# Any DOCLING_* / DOCLING_RS_* variable is read by docling directly, e.g.:
#   DOCLING_RS_EP=cpu|cuda|auto
#   DOCLING_RS_VLM_ENDPOINT / _MODEL / _API_KEY / _PROMPT / _TIMEOUT
