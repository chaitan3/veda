# local-search configuration
#
# Docling's own settings are NOT wrapped here. Anything `DOCLING_*` /
# `DOCLING_RS_*` is read by docling directly, e.g.:
#   DOCLING_RS_OCR_LANG=en|ch
#   DOCLING_OCR_REC_ONNX=...   DOCLING_OCR_DICT=...
#   DOCLING_LAYOUT_ONNX=...    DOCLING_TABLEFORMER_{ENCODER,DECODER,BBOX}=...
#   DOCLING_RS_EP=auto|cpu|cuda|...  (default auto: CUDA if usable, else CPU)
#   DOCLING_RS_FP32=1
#   DOCLING_CHUNK_TOKENIZER=... DOCLING_CHUNK_MAX_TOKENS=256
#   DOCLING_RS_VLM_ENDPOINT / _MODEL / _API_KEY / _PROMPT / _TIMEOUT
# CUDA memory (vendored docling-onnx patch — see vendor/docling-onnx):
#   DOCLING_RS_CUDA_CONV_ALGO=heuristic|exhaustive|default   (default heuristic)
#   DOCLING_RS_CUDA_CONV_MAX_WORKSPACE=1                     (default 0 = 32 MB cap)
#   DOCLING_RS_CUDA_ARENA_EXTEND=same_as_requested|next_power_of_two
#   DOCLING_RS_CUDA_MEM_LIMIT_MB=<n>                         (default: unbounded)
#   DOCLING_RS_CUDA_ARENA_SHRINK=0                           (default on: free GPU arena
#       chunks after every Run, so batch ingests stop ratcheting VRAM; ~10-20% slower)
# Diagnostics (docling):
#   DOCLING_RS_TIMING=1                                      per-stage timing logs
#   DOCLING_RS_GRAPH_CACHE_DIR=...                           ONNX graph cache location
#   DOCLING_RS_NO_GRAPH_CACHE=1                              disable the graph cache
#   DOCLING_RS_NO_ARENA=1                                    disable ORT arenas entirely
#   DOCLING_RS_XNNPACK_THREADS=<n>                           CPU EP thread count
#   DOCLING_RS_COREML_{UNITS,FORMAT,STATIC_SHAPES}=...        macOS/CoreML only

# Cap on the ONNX text-embedder's encoded sequence length (BPE tokens).
# Chunk sizes count WORDS, and tables/OCR noise/code tokenize to far more
# tokens than words — over-long chunks are truncated with a warning. Keep
# this <= the model's position-embedding table (512 for BGE-style encoders);
# raising it beyond that crashes inside the graph.
# LS_EMBED_MAX_TOKENS=512
# Refuse to start when LS_CHUNK_SIZE exceeds that window (default: warn and
# truncate). Truncation is silent quality loss, so a strict deployment may
# prefer the hard error.
# LS_CHUNK_STRICT=false

# Per-folder policy: image files under these folders are indexed by the image
# channel ONLY (no docling conversion, no OCR, no text chunks) — e.g. photo
# dumps. Path-separated list, like LS_SOURCE_PATH. Removing a folder from this
# list promotes its documents back to full text on the next plain ingest.
# LS_IMAGE_ONLY_PATHS=/photos:/scans

# ---- scheduled ingest ------------------------------------------------------
# While `serve` runs, ingest the source folders every interval. The first run
# happens immediately (catch-up), then each interval. `off` (or unset) keeps
# ingest manual. Units: s|m|h|d, or a bare number of seconds.
# LS_INGEST_INTERVAL=24h
# Also drop documents whose source files disappeared (same scope as
# `ingest --sync`: the LS_SOURCE_PATH roots). Off by default.
# LS_INGEST_SYNC=false

# ---- storage & source ------------------------------------------------------
LS_DB_PATH=data/local-search.db
# One or more folders, path-separated (`:` on Linux). e.g. docs:archive
LS_SOURCE_PATH=docs
# Where the model tree lives. Defaults to .models (docling's own convention);
# set it only if you moved the tree — it fans out to docling's per-model
# DOCLING_* variables. pdfium is resolved at .pdfium/lib.
# LS_MODELS_DIR=.models

# ---- extraction ------------------------------------------------------------
# onnx = local docling ONNX pipeline (default); vlm = remote OpenAI-compatible
# VLM via llama.cpp (configure DOCLING_RS_VLM_* above).
LS_EXTRACT_PIPELINE=onnx
# CodeFormulaV2 enrichment: transcribe code blocks and display formulas.
# Needs the models fetched by `download-models`; a missing model is skipped.
# Default: on for CPU, off when the ONNX provider resolves to CUDA (the fp32
# models do not fit alongside the rest on a modest GPU). Uncomment to force on.
# LS_EXTRACT_CODE_FORMULA=true

# ---- embeddings ------------------------------------------------------------
# hash | llamacpp | onnx | eg2
#   onnx     in-process sentence encoder (default; build with --features onnx-embed)
#   eg2      EmbeddingGemma 2 text graph: 768-d, multilingual/code, and — with
#            LS_IMAGE_EMBED_PROVIDER=eg2 — one shared text+image space. fp32
#            only (fp16 returns NaN). Fetched by `download-models`.
#   llamacpp OpenAI-compatible /v1/embeddings (your llama.cpp server)
#   hash     deterministic offline embedder (smoke tests only)
LS_EMBED_PROVIDER=onnx
# LS_EMBED_DIM follows the provider (onnx 384, eg2 768) unless set explicitly.
LS_EMBED_DIM=384
# Defaults point at the bge-small-en-v1.5 model fetched by `download-models`:
# LS_ONNX_MODEL=.models/embed/bge-small-en-v1.5.onnx
# LS_ONNX_TOKENIZER=.models/embed/tokenizer.json
# Override the download base for the embedder:
# LS_ONNX_MODELS_URL=https://huggingface.co/Xenova/bge-small-en-v1.5/resolve/main
# ...for the image models (SigLIP2):
# LS_IMAGE_MODELS_URL=https://huggingface.co/onnx-community/siglip2-base-patch16-224-ONNX/resolve/main
# ...and for EmbeddingGemma 2:
# LS_EG2_MODELS_URL=https://huggingface.co/onnx-community/embeddinggemma-2-ONNX/resolve/main

# llamacpp settings (LS_EMBED_PROVIDER=llamacpp)
LS_LLAMACPP_URL=http://127.0.0.1:8080/v1
# LS_EMBED_MODEL=bge-m3
# LS_LLAMACPP_API_KEY=
# Prefixes for e5/bge-style models:
# LS_EMBED_QUERY_PREFIX="query: "
# LS_EMBED_DOC_PREFIX="passage: "

# ---- image embeddings ------------------------------------------------------
# off | hash | siglip  (default siglip)
#   siglip  SigLIP2 shared image+text space: a text query matches images, and
#           an image query matches images. Models are fetched by
#           `download-models`; set off to skip the image channel entirely.
#   eg2     EmbeddingGemma 2 vision encoder (768-d, 280 soft tokens): with
#           LS_EMBED_PROVIDER=eg2 both modalities land in ONE space and ONE
#           vector index, so a single query vector serves text and images
#           alike (mode=image becomes a kind filter).
#   hash    deterministic offline stub (smoke tests only)
LS_IMAGE_EMBED_PROVIDER=siglip
LS_IMAGE_EMBED_DIM=768
# EG2 model paths (LS_*_PROVIDER=eg2); defaults point at download-models:
# LS_EG2_TEXT_MODEL=.models/eg2/text/model.onnx
# LS_EG2_TOKENIZER=.models/eg2/tokenizer.json
# LS_EG2_VISION_MODEL=.models/eg2/vision/vision_encoder.onnx
# LS_EG2_PROCESSOR=.models/eg2/processor_config.json
# Vision budget: 70|140|280|560|1120 soft tokens per image (default 280).
# Higher captures more detail at proportionally more compute/VRAM.
# LS_IMAGE_SOFT_TOKENS=280
# Defaults point at the SigLIP2 towers fetched by download-models:
# LS_SIGLIP_VISION_MODEL=.models/image/vision_model.onnx
# LS_SIGLIP_TEXT_MODEL=.models/image/text_model.onnx
# LS_SIGLIP_TOKENIZER=.models/image/tokenizer.json
# LS_SIGLIP_PREPROCESSOR=.models/image/preprocessor_config.json

# ---- chunking --------------------------------------------------------------
# hybrid (default) | hierarchical | window
#   hybrid/hierarchical use docling's structure-aware chunkers (need the
#   document tree + .models/chunk/tokenizer.json); plain text falls back to window.
#   Size semantics differ per chunker (see docs/PRODUCTION.md): hybrid counts
#   TOKENS (docling enforces the budget), window counts WORDS, hierarchical has
#   no size budget — the embedder truncates to LS_EMBED_MAX_TOKENS regardless.
LS_CHUNKER=hybrid
LS_CHUNK_SIZE=300
LS_CHUNK_OVERLAP=0.05

# ---- retrieval -------------------------------------------------------------
LS_RRF_K=60

# ---- service ---------------------------------------------------------------
LS_ADDR=127.0.0.1:8080
# Empty = authentication disabled (loopback default). Comma-separated list.
# LS_API_KEYS=dev-key
